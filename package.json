  "bugs": {
    "url": "https://github.com/Arda-Akdeniz/master-meter-web/issues"
  },
  "homepage": "https://github.com/Arda-Akdeniz/master-meter-web#readme",
  "lint-staged": {
    "src/**/*.js": "eslint --fix",
    "src/**/*.css": "stylelint --fix",
    "src/**/*.{js,css,html}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
